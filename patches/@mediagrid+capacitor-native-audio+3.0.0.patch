+    // patch: stop notification + service when all app controllers disconnect
+    @OptIn(markerClass = UnstableApi.class)
+    public void handleControllerDisconnected(MediaSession session) {
+        new Handler(Looper.getMainLooper()).post(() -> {
+            try {
+                boolean hasAppController = false;
+                for (MediaSession.ControllerInfo controller : session.getConnectedControllers()) {
+                    if (!session.isMediaNotificationController(controller)) {
+                        hasAppController = true;
+                        break;
+                    }
+                }
+
+                if (!hasAppController) {
+                    Log.i(TAG, "All app controllers disconnected - removing notification and stopping service");
+
+                    if (mediaSession != null && mediaSession.getPlayer() != null) {
+                        mediaSession.getPlayer().stop();
+                    }
+
+                    stopForeground(Service.STOP_FOREGROUND_REMOVE);
+                    stopSelf();
+                }
+            } catch (Exception ex) {
+                Log.e(TAG, "Error while handling controller disconnect", ex);
+            }
+        });
